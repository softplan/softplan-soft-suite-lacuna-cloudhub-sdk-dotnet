<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Softplan.Soft.Suite.Lacuna.Cloudhub.Sdk</AssemblyName>
    <RootNamespace>Softplan.Soft.Suite.Lacuna.Cloudhub.Sdk</RootNamespace>
  </PropertyGroup>
  <PropertyGroup Label="NuGet">
    <PackageId>Softplan.SoftSuite.Lacuna.Cloudhub</PackageId>
    <Title>Lacuna Cloudhub .NET SDK</Title>
    <Description>Modern, strongly typed .NET SDK for the Lacuna Cloudhub API, generated from the official OpenAPI specification with AutoSDK.</Description>
    <PackageTags>lacuna;cloudhub;digital-signature;certificate;trust-service;api;client;sdk;dotnet;openapi;autosdk</PackageTags>
    <PackageProjectUrl>https://github.com/softplan/softplan-soft-suite-lacuna-cloudhub-sdk-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/softplan/softplan-soft-suite-lacuna-cloudhub-sdk-dotnet.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>
</Project>
